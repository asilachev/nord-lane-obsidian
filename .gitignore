.DS_Store
__pycache__/

# The demo vault: the theme is built into it (python3 build.py demo), and Obsidian keeps
# its own window and plugin state there.
demo/.obsidian/themes/
demo/.obsidian/workspace*.json
demo/.obsidian/core-plugins.json

# The live harness: screenshots and the test Obsidian's own settings folder.
tools/live/shots/
tools/live/userdata/

# Plugins installed in the demo vault for testing (Style Settings).
demo/.obsidian/plugins/
demo/.obsidian/community-plugins.json

# The landing page build (node scripts/build-site.mjs).
_site/
